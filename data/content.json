  "process": [
    {
      "title": {
        "es": "Brief",
        "en": "Brief"
      },
      "text": {
        "es": "Hablamos de tu objetivo, tu público y los plazos.",
        "en": "We talk about your goal, your audience and deadlines."
      }
    },
    {
      "title": {
        "es": "Propuesta",
        "en": "Proposal"
      },
      "text": {
        "es": "Te muestro bocetos y una dirección visual antes de producir.",
        "en": "I show you sketches and a visual direction before production."
      }
    },
    {
      "title": {
        "es": "Diseño",
        "en": "Design"
      },
      "text": {
        "es": "Producción con rondas de revisión claras.",
        "en": "Production with clear review rounds."
      }
    },
    {
      "title": {
        "es": "Entrega",
        "en": "Delivery"
      },
      "text": {
        "es": "Archivos finales y editables, ordenados y listos para usar.",
        "en": "Final and editable files, organized and ready to use."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "es": "¿Trabajas con agencias y clientes de Puerto Rico y EE. UU.?",
        "en": "Do you work with agencies and clients in Puerto Rico and the US?"
      },
      "a": {
        "es": "Sí. He trabajado con agencias de Puerto Rico, Estados Unidos, Chile y Colombia. Trabajo remoto en horario UTC−4, el mismo de Puerto Rico.",
        "en": "Yes. I've worked with agencies in Puerto Rico, the United States, Chile and Colombia. I work remotely on UTC−4, the same time zone as Puerto Rico."
      }
    },
    {
      "q": {
        "es": "¿Qué incluye la entrega de un proyecto?",
        "en": "What does a project delivery include?"
      },
      "a": {
        "es": "Archivos finales en los formatos que necesites (PNG, SVG, PDF, MP4) y, si lo acordamos, los editables originales (PSD, AI, XD).",
        "en": "Final files in the formats you need (PNG, SVG, PDF, MP4) and, if agreed, the original editable files (PSD, AI, XD)."
      }
    },
    {
      "q": {
        "es": "¿Puedes crear una página web o landing page?",
        "en": "Can you build a website or landing page?"
      },
      "a": {
        "es": "Sí. Diseño la interfaz y la construyo con HTML, CSS y JavaScript asistido por IA, con estructura pensada para SEO y buena velocidad en móvil.",
        "en": "Yes. I design the interface and build it with AI-assisted HTML, CSS and JavaScript, structured for SEO and fast on mobile."
      }
    },
    {
      "q": {
        "es": "¿Cómo creas juegos con IA?",
        "en": "How do you make games with AI?"
      },
      "a": {
        "es": "Uso la IA como acelerador para mecánicas, código y arte, y lo integro en juegos web con canvas, tienda y base de datos. Pica Jump es un ejemplo.",
        "en": "I use AI to speed up mechanics, code and art, and integrate it into web games with canvas, shop and database. Pica Jump is an example."
      }
    },
    {
      "q": {
        "es": "¿Cuánto tarda un proyecto?",
        "en": "How long does a project take?"
      },
      "a": {
        "es": "Depende del alcance. Te doy un plazo claro en la propuesta, antes de empezar.",
        "en": "It depends on scope. You get a clear timeline in the proposal, before we start."
      }
    }
  ]
}
